From 416ca9e53fd5ca99698f786e7bb11ca263686ae9 Mon Sep 17 00:00:00 2001
From: "Can H. Tartanoglu" <gpg@rotas.mozmail.com>
Date: Thu, 23 Apr 2026 10:46:51 +0200
Subject: [PATCH] linux-pipewire: send restore metadata to portal

Read RestorePolicyAction unconditionally on both create and update. OBS
registers its default before source instances are created, so upgraded sources
without a saved user value resolve through obs_data_get_int() to the registered
Skip default instead of falling through to Prompt.

Send restore_match_rules only with a restore_token, matching restore_policy's
restore-only behavior and keeping fresh selections behaviorally unchanged.

Signed-off-by: Can H. Tartanoglu <gpg@rotas.mozmail.com>

---
 plugins/linux-pipewire/data/locale/en-US.ini |   6 +
 plugins/linux-pipewire/screencast-portal.c   | 124 ++++++++++++++++++-
 2 files changed, 128 insertions(+), 2 deletions(-)

diff --git a/plugins/linux-pipewire/data/locale/en-US.ini b/plugins/linux-pipewire/data/locale/en-US.ini
index a7eedd1..52538da 100644
--- a/plugins/linux-pipewire/data/locale/en-US.ini
+++ b/plugins/linux-pipewire/data/locale/en-US.ini
@@ -10,2 +10,8 @@ PipeWireSelectScreenCast="Open Selector"
 ShowCursor="Show Cursor"
+RestorePolicyAction="On restore failure"
+RestorePolicyAction.Prompt="Prompt user"
+RestorePolicyAction.Skip="Skip silently"
+RestorePolicyAction.Error="Report error"
+RestoreMatchRules="Restore title aliases (regex, one per line)"
+RestoreMatchRules.ToolTip="One Rust regex per line. Rules are searched case-insensitively within window titles. Rules default to same_app; prefix a line with same:, same_app:, any:, or any_app:. Rust regex does not support lookaround or backreferences."
 VideoFormat="Video Format"
diff --git a/plugins/linux-pipewire/screencast-portal.c b/plugins/linux-pipewire/screencast-portal.c
index d5fe531..b00e463 100644
--- a/plugins/linux-pipewire/screencast-portal.c
+++ b/plugins/linux-pipewire/screencast-portal.c
@@ -24,2 +24,3 @@
 #include <gio/gunixfdlist.h>
+#include <string.h>
 
@@ -59,2 +60,4 @@ struct screencast_portal_capture {
 	obs_pipewire_stream *obs_pw_stream;
+	uint32_t restore_action;
+	char *restore_match_rules;
 };
@@ -213,2 +216,76 @@ static void open_pipewire_remote(struct screencast_portal_capture *capture)
 
+static void add_restore_match_rules(GVariantBuilder *builder, const char *text)
+{
+	if (!text || !*text)
+		return;
+
+	GVariantBuilder rules;
+	g_variant_builder_init(&rules, G_VARIANT_TYPE("aa{sv}"));
+
+	bool added = false;
+	gchar **lines = g_strsplit(text, "\n", -1);
+	for (char **line_ptr = lines; line_ptr && *line_ptr; line_ptr++) {
+		char *line = g_strstrip(*line_ptr);
+		if (!*line)
+			continue;
+
+		const char *scope = "same_app";
+		const char *pattern = line;
+		if (g_str_has_prefix(pattern, "any_app:")) {
+			scope = "any_app";
+			pattern += strlen("any_app:");
+		} else if (g_str_has_prefix(pattern, "any:")) {
+			scope = "any_app";
+			pattern += strlen("any:");
+		} else if (g_str_has_prefix(pattern, "same_app:")) {
+			scope = "same_app";
+			pattern += strlen("same_app:");
+		} else if (g_str_has_prefix(pattern, "same:")) {
+			scope = "same_app";
+			pattern += strlen("same:");
+		}
+
+		pattern = g_strstrip((char *)pattern);
+		if (!*pattern)
+			continue;
+
+		GVariantBuilder rule;
+		g_variant_builder_init(&rule, G_VARIANT_TYPE_VARDICT);
+		g_variant_builder_add(&rule, "{sv}", "kind", g_variant_new_string("title_regex"));
+		g_variant_builder_add(&rule, "{sv}", "pattern", g_variant_new_string(pattern));
+		g_variant_builder_add(&rule, "{sv}", "scope", g_variant_new_string(scope));
+		g_variant_builder_add_value(&rules, g_variant_builder_end(&rule));
+		added = true;
+	}
+	g_strfreev(lines);
+
+	if (added)
+		g_variant_builder_add(builder, "{sv}", "restore_match_rules", g_variant_builder_end(&rules));
+	else
+		g_variant_builder_clear(&rules);
+}
+
+static bool handle_restore_failure(struct screencast_portal_capture *capture, GVariant *result, const char *phase)
+{
+	GVariant *restore_failure = g_variant_lookup_value(result, "restore_failure", G_VARIANT_TYPE_VARDICT);
+	if (!restore_failure)
+		return false;
+
+	const char *reason = NULL;
+	gboolean token_invalid = FALSE;
+	g_variant_lookup(restore_failure, "reason", "&s", &reason);
+	g_variant_lookup(restore_failure, "token_invalid", "b", &token_invalid);
+
+	blog(LOG_WARNING, "[pipewire] Failed to %s: restore failure reason=%s token_invalid=%s", phase,
+	     reason ? reason : "unknown", token_invalid ? "true" : "false");
+
+	if (token_invalid) {
+		g_clear_pointer(&capture->restore_token, bfree);
+		obs_source_save(capture->source);
+	}
+
+	g_variant_unref(restore_failure);
+	return true;
+}
+
 static void on_start_response_received_cb(GVariant *parameters, void *user_data)
@@ -226,3 +303,4 @@ static void on_start_response_received_cb(GVariant *parameters, void *user_data)
 	if (response != 0) {
-		blog(LOG_WARNING, "[pipewire] Failed to start screencast, denied or cancelled by user");
+		if (!handle_restore_failure(capture, result, "start screencast"))
+			blog(LOG_WARNING, "[pipewire] Failed to start screencast, denied or cancelled by user");
 		return;
@@ -322,3 +400,4 @@ static void on_select_source_response_received_cb(GVariant *parameters, void *us
 	if (response != 0) {
-		blog(LOG_WARNING, "[pipewire] Failed to select source, denied or cancelled by user");
+		if (!handle_restore_failure(capture, ret, "select source"))
+			blog(LOG_WARNING, "[pipewire] Failed to select source, denied or cancelled by user");
 		return;
@@ -379,2 +458,20 @@ static void select_source(struct screencast_portal_capture *capture)
 
+	if (get_screencast_version() >= 6) {
+		const char *source_name = obs_source_get_name(capture->source);
+		if (source_name && *source_name)
+			g_variant_builder_add(&builder, "{sv}", "source_label",
+					      g_variant_new_string(source_name));
+
+		if (capture->restore_token && *capture->restore_token) {
+			GVariantBuilder policy;
+			g_variant_builder_init(&policy, G_VARIANT_TYPE_VARDICT);
+			g_variant_builder_add(&policy, "{sv}", "default_action",
+					      g_variant_new_uint32(capture->restore_action));
+			g_variant_builder_add(&builder, "{sv}", "restore_policy",
+					      g_variant_builder_end(&policy));
+
+			add_restore_match_rules(&builder, capture->restore_match_rules);
+		}
+	}
+
 	g_dbus_proxy_call(get_screencast_portal_proxy(), "SelectSources",
@@ -519,2 +616,4 @@ static void *screencast_portal_desktop_capture_create(obs_data_t *settings, obs_
 	capture->restore_token = bstrdup(obs_data_get_string(settings, "RestoreToken"));
+	capture->restore_action = (uint32_t)obs_data_get_int(settings, "RestorePolicyAction");
+	capture->restore_match_rules = bstrdup(obs_data_get_string(settings, "RestoreMatchRules"));
 	capture->source = source;
@@ -533,2 +632,4 @@ static void *screencast_portal_window_capture_create(obs_data_t *settings, obs_s
 	capture->restore_token = bstrdup(obs_data_get_string(settings, "RestoreToken"));
+	capture->restore_action = (uint32_t)obs_data_get_int(settings, "RestorePolicyAction");
+	capture->restore_match_rules = bstrdup(obs_data_get_string(settings, "RestoreMatchRules"));
 	capture->source = source;
@@ -548,2 +649,4 @@ static void *screencast_portal_capture_create(obs_data_t *settings, obs_source_t
 	capture->restore_token = bstrdup(obs_data_get_string(settings, "RestoreToken"));
+	capture->restore_action = (uint32_t)obs_data_get_int(settings, "RestorePolicyAction");
+	capture->restore_match_rules = bstrdup(obs_data_get_string(settings, "RestoreMatchRules"));
 	capture->source = source;
@@ -571,2 +674,3 @@ static void screencast_portal_capture_destroy(void *data)
 	g_clear_pointer(&capture->restore_token, bfree);
+	g_clear_pointer(&capture->restore_match_rules, bfree);
 
@@ -590,2 +694,4 @@ static void screencast_portal_capture_get_defaults(obs_data_t *settings)
 	obs_data_set_default_string(settings, "RestoreToken", NULL);
+	obs_data_set_default_int(settings, "RestorePolicyAction", 1);
+	obs_data_set_default_string(settings, "RestoreMatchRules", NULL);
 }
@@ -616,2 +722,13 @@ static obs_properties_t *screencast_portal_capture_get_properties(void *data)
 
+	obs_property_t *mode_prop = obs_properties_add_list(properties, "RestorePolicyAction",
+							    obs_module_text("RestorePolicyAction"), OBS_COMBO_TYPE_LIST,
+							    OBS_COMBO_FORMAT_INT);
+	obs_property_list_add_int(mode_prop, obs_module_text("RestorePolicyAction.Prompt"), 0);
+	obs_property_list_add_int(mode_prop, obs_module_text("RestorePolicyAction.Skip"), 1);
+	obs_property_list_add_int(mode_prop, obs_module_text("RestorePolicyAction.Error"), 2);
+	obs_property_t *rules_prop = obs_properties_add_text(properties, "RestoreMatchRules",
+							     obs_module_text("RestoreMatchRules"),
+							     OBS_TEXT_MULTILINE);
+	obs_property_set_long_description(rules_prop, obs_module_text("RestoreMatchRules.ToolTip"));
+
 	return properties;
@@ -624,2 +741,5 @@ static void screencast_portal_capture_update(void *data, obs_data_t *settings)
 	capture->cursor_visible = obs_data_get_bool(settings, "ShowCursor");
+	capture->restore_action = (uint32_t)obs_data_get_int(settings, "RestorePolicyAction");
+	g_clear_pointer(&capture->restore_match_rules, bfree);
+	capture->restore_match_rules = bstrdup(obs_data_get_string(settings, "RestoreMatchRules"));
 
-- 
2.53.0
