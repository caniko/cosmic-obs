From cfa28b6513df843dd609d66d4031fdb599c68df1 Mon Sep 17 00:00:00 2001
From: agent <agent@local>
Date: Fri, 10 Apr 2026 09:13:31 +0200
Subject: [PATCH] screencast: add source_label and restore_fail_mode to
 SelectSources

---
 data/org.freedesktop.portal.ScreenCast.xml |  66 ++++++++++++-
 src/screen-cast.c                          | 103 +++++++++++++++++++--
 2 files changed, 162 insertions(+), 7 deletions(-)

diff --git a/data/org.freedesktop.portal.ScreenCast.xml b/data/org.freedesktop.portal.ScreenCast.xml
index 8233242..9371643 100644
--- a/data/org.freedesktop.portal.ScreenCast.xml
+++ b/data/org.freedesktop.portal.ScreenCast.xml
@@ -25,7 +25,7 @@
 
       The Screen cast portal allows to create screen cast sessions.
 
-      This documentation describes version 5 of this interface.
+      This documentation describes version 6 of this interface.
   -->
   <interface name="org.freedesktop.portal.ScreenCast">
     <!--
@@ -145,6 +145,70 @@
 
           This option was added in version 4 of this interface.
 
+        * ``source_label`` (``s``)
+
+          A human-readable label for this source request. An optional hint
+          provided by the application to identify the purpose or origin of
+          this SelectSources call. If supported by the portal backend, this
+          string should be surfaced in the source picker dialog. Backends
+          that do not support this key must ignore it. Backends SHOULD treat
+          an empty string the same as an absent key.
+
+          This string is plain text. Backends MUST NOT interpret it as Pango
+          markup, HTML, or any other rich text format. Backends SHOULD
+          truncate labels exceeding 256 bytes for display. Backends SHOULD
+          strip Unicode control characters (U+0000-U+001F, U+007F,
+          U+200E-U+200F, U+202A-U+202E, U+2066-U+2069) before display.
+          The label is untrusted application-provided input with the same
+          trust model as window titles.
+
+          This option was added in version 6 of this interface.
+
+        * ``restore_fail_mode`` (``u``)
+
+          Determines what the portal does when a restore_token is provided
+          but the session cannot be restored. Allowed values:
+
+          - ``0`` - prompt (default): show the source picker as if no token was
+            provided. This is the default and preserves current behaviour.
+          - ``1`` - skip: do not show the picker; return response=1 via the
+            Request::Response signal.
+          - ``2`` - error: do not show the picker; return response=2 with
+            restore_failed=true in the results vardict.
+
+          Has no effect if no restore_token is provided. Has no effect on
+          RemoteDesktop sessions, where restore_token is not supported.
+
+          The skip and error modes do not bypass user consent. They only
+          activate when a previously-consented restore_token cannot be
+          honoured. No new source access is granted without user interaction.
+
+          This option was added in version 6 of this interface.
+
+      The following results get returned via the
+      org.freedesktop.portal.Request::Response signal when restore_fail_mode
+      is set to a non-zero value:
+
+        * ``restore_failed`` (``b``)
+
+          Present and set to true when response is 2 and the failure was
+          caused specifically by an inability to honour a provided
+          restore_token combined with restore_fail_mode set to 2.
+          Applications receiving this result SHOULD discard the stale
+          restore_token and either re-initiate SelectSources without a
+          token (to trigger the picker) or defer to a user action.
+          This result was added in version 6 of this interface.
+
+      When restore_fail_mode is set to 1 or 2 and the restore_token cannot
+      be honoured, the SelectSources method itself completes normally. The
+      failure is communicated via the Request::Response signal and the
+      session is closed by the portal. Callers MUST subscribe to the
+      Request::Response signal before calling SelectSources to observe
+      these outcomes.
+
+      Portal implementations MUST ignore restore_fail_mode when no
+      restore_token is present in the same SelectSources call.
+
         For available source types, see the AvailableSourceTypes property.
     -->
     <method name="SelectSources">
diff --git a/src/screen-cast.c b/src/screen-cast.c
index 562d53a..01930fc 100644
--- a/src/screen-cast.c
+++ b/src/screen-cast.c
@@ -423,12 +423,51 @@ validate_persist_mode (const char *key,
   return TRUE;
 }
 
+static gboolean
+validate_source_label (const char *key,
+                       GVariant *value,
+                       GVariant *options,
+                       GError **error)
+{
+  const char *label = g_variant_get_string (value, NULL);
+  gsize len = strlen (label);
+
+  if (len > 256)
+    {
+      g_set_error (error, XDG_DESKTOP_PORTAL_ERROR, XDG_DESKTOP_PORTAL_ERROR_INVALID_ARGUMENT,
+                   "source_label exceeds 256 bytes (%zu)", len);
+      return FALSE;
+    }
+
+  return TRUE;
+}
+
+static gboolean
+validate_restore_fail_mode (const char *key,
+                              GVariant *value,
+                              GVariant *options,
+                              GError **error)
+{
+  guint32 policy = g_variant_get_uint32 (value);
+
+  if (policy > 2)
+    {
+      g_set_error (error, XDG_DESKTOP_PORTAL_ERROR, XDG_DESKTOP_PORTAL_ERROR_INVALID_ARGUMENT,
+                   "Invalid restore_fail_mode value: %u", policy);
+      return FALSE;
+    }
+
+  return TRUE;
+}
+
 static XdpOptionKey screen_cast_select_sources_options[] = {
   { "types", G_VARIANT_TYPE_UINT32, validate_source_types },
   { "multiple", G_VARIANT_TYPE_BOOLEAN, NULL },
   { "cursor_mode", G_VARIANT_TYPE_UINT32, validate_cursor_mode },
   { "restore_token", G_VARIANT_TYPE_STRING, validate_restore_token },
   { "persist_mode", G_VARIANT_TYPE_UINT32, validate_persist_mode },
+  { "source_label", G_VARIANT_TYPE_STRING, validate_source_label },
+  { "restore_fail_mode", G_VARIANT_TYPE_UINT32, validate_restore_fail_mode },
 };
 
 static gboolean
@@ -586,11 +625,63 @@ handle_select_sources (XdpDbusScreenCast *object,
    * permission store and / or the GHashTable with transient permissions.
    * Portal implementations do not have access to the restore token.
    */
-  if (!replace_screen_cast_restore_token_with_data (session, &options, &error))
-    {
-      g_dbus_method_invocation_return_gerror (invocation, error);
-      return G_DBUS_METHOD_INVOCATION_HANDLED;
-    }
+  {
+    gboolean had_restore_token;
+    guint32 restore_fail_mode = 0;
+
+    had_restore_token = xdp_variant_contains_key (options, "restore_token");
+
+    /* validate_restore_fail_mode (option validator) rejects values > 2
+     * before we reach this point, so no clamp is needed here. */
+    g_variant_lookup (options, "restore_fail_mode", "u", &restore_fail_mode);
+
+    /* Note: had_restore_token is captured before replace_screen_cast_restore_token_with_data
+     * mutates options. The three outcomes (error/restored/stale) all produce correct
+     * behaviour with the captured value: on error we return early; on successful restore
+     * the "restore_data" key is added; on a stale token neither "restore_token" nor
+     * "restore_data" is set, which is exactly when had_restore_token triggers fail_mode. */
+    if (!replace_screen_cast_restore_token_with_data (session, &options, &error))
+      {
+        g_dbus_method_invocation_return_gerror (invocation, error);
+        return G_DBUS_METHOD_INVOCATION_HANDLED;
+      }
+
+    if (had_restore_token &&
+        !xdp_variant_contains_key (options, "restore_data") &&
+        restore_fail_mode != 0)
+      {
+        guint response;
+        g_auto(GVariantBuilder) results_builder =
+          G_VARIANT_BUILDER_INIT (G_VARIANT_TYPE_VARDICT);
+
+        if (restore_fail_mode == 1)
+          {
+            response = 1;
+          }
+        else
+          {
+            response = 2;
+            g_variant_builder_add (&results_builder, "{sv}",
+                                   "restore_failed",
+                                   g_variant_new_boolean (TRUE));
+          }
+
+        xdp_dbus_request_emit_response (XDP_DBUS_REQUEST (request),
+                                         response,
+                                         g_variant_builder_end (&results_builder));
+        xdp_request_unexport (request);
+
+        /* Session close is best-effort: xdp_session_close returns void.
+         * If the underlying D-Bus proxy call fails, the session state is
+         * already unusable from the caller's perspective (they received
+         * the fail response), so best-effort matches the existing semantics. */
+        if (IS_SCREEN_CAST_SESSION (session))
+          xdp_session_close (session, TRUE);
+
+        xdp_dbus_screen_cast_complete_select_sources (object, invocation, request->id);
+        return G_DBUS_METHOD_INVOCATION_HANDLED;
+      }
+  }
 
   g_object_set_qdata_full (G_OBJECT (request),
                            quark_request_session,
@@ -1070,7 +1161,7 @@ on_supported_cursor_modes_changed (GObject *gobject,
 static void
 screen_cast_init (ScreenCast *screen_cast)
 {
-  xdp_dbus_screen_cast_set_version (XDP_DBUS_SCREEN_CAST (screen_cast), 5);
+  xdp_dbus_screen_cast_set_version (XDP_DBUS_SCREEN_CAST (screen_cast), 6);
 
   g_signal_connect (impl, "notify::supported-source-types",
                     G_CALLBACK (on_supported_source_types_changed),
-- 
2.53.0

