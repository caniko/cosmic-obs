From 6301617e8cf8a859dca241f464045b8ca35ed41a Mon Sep 17 00:00:00 2001
From: agent <agent@local>
Date: Fri, 10 Apr 2026 09:34:53 +0200
Subject: [PATCH] remote: add source_label and restore_fail_mode to screencast
 API

---
 libportal/remote.c | 96 ++++++++++++++++++++++++++++++++++++++++++++++
 libportal/remote.h | 28 ++++++++++++++
 2 files changed, 124 insertions(+)

diff --git a/libportal/remote.c b/libportal/remote.c
index a0da823..86e0856 100644
--- a/libportal/remote.c
+++ b/libportal/remote.c
@@ -34,6 +34,8 @@ typedef struct {
   XdpCursorMode cursor_mode;
   XdpPersistMode persist_mode;
   char *restore_token;
+  char *source_label;
+  XdpRestoreFailMode restore_fail_mode;
   gboolean multiple;
   guint signal_id;
   GTask *task;
@@ -51,6 +53,7 @@ create_call_free (CreateCall *call)
 
   g_free (call->request_path);
   g_free (call->restore_token);
+  g_free (call->source_label);
 
   g_object_unref (call->portal);
   g_object_unref (call->task);
@@ -141,6 +144,12 @@ select_sources (CreateCall *call)
       if (call->restore_token)
         g_variant_builder_add (&options, "{sv}", "restore_token", g_variant_new_string (call->restore_token));
     }
+  if (call->portal->screencast_interface_version >= 6)
+    {
+      if (call->source_label && *call->source_label)
+        g_variant_builder_add (&options, "{sv}", "source_label", g_variant_new_string (call->source_label));
+      g_variant_builder_add (&options, "{sv}", "restore_fail_mode", g_variant_new_uint32 (call->restore_fail_mode));
+    }
   g_dbus_connection_call (call->portal->bus,
                           PORTAL_BUS_NAME,
                           PORTAL_OBJECT_PATH,
@@ -453,6 +462,55 @@ xdp_portal_create_screencast_session (XdpPortal *portal,
                                       GCancellable *cancellable,
                                       GAsyncReadyCallback  callback,
                                       gpointer data)
+{
+  xdp_portal_create_screencast_session_full (portal,
+                                             outputs,
+                                             flags,
+                                             cursor_mode,
+                                             persist_mode,
+                                             restore_token,
+                                             NULL,
+                                             XDP_RESTORE_FAIL_MODE_PROMPT,
+                                             cancellable,
+                                             callback,
+                                             data);
+}
+
+/**
+ * xdp_portal_create_screencast_session_full: (finish-func xdp_portal_create_screencast_session_finish)
+ * @portal: a [class@Portal]
+ * @outputs: which kinds of source to offer in the dialog
+ * @flags: options for this call
+ * @cursor_mode: the cursor mode of the session
+ * @persist_mode: the persist mode of the session
+ * @restore_token: (nullable): the token of a previous screencast session to restore
+ * @source_label: (nullable): a human-readable label for the source
+ * @restore_fail_mode: the policy when a restore token cannot be honoured
+ * @cancellable: (nullable): optional [class@Gio.Cancellable]
+ * @callback: (scope async): a callback to call when the request is done
+ * @data: data to pass to @callback
+ *
+ * Creates a session for a screencast.
+ *
+ * This is the same as [method@Portal.create_screencast_session], but
+ * additionally allows specifying @source_label and @restore_fail_mode.
+ * These options require portal interface version 6 or later.
+ *
+ * When the request is done, @callback will be called. You can then
+ * call [method@Portal.create_screencast_session_finish] to get the results.
+ */
+void
+xdp_portal_create_screencast_session_full (XdpPortal *portal,
+                                           XdpOutputType outputs,
+                                           XdpScreencastFlags flags,
+                                           XdpCursorMode cursor_mode,
+                                           XdpPersistMode persist_mode,
+                                           const char *restore_token,
+                                           const char *source_label,
+                                           XdpRestoreFailMode restore_fail_mode,
+                                           GCancellable *cancellable,
+                                           GAsyncReadyCallback  callback,
+                                           gpointer data)
 {
   CreateCall *call;
 
@@ -467,6 +525,44 @@ xdp_portal_create_screencast_session (XdpPortal *portal,
   call->cursor_mode = cursor_mode;
   call->persist_mode = persist_mode;
   call->restore_token = g_strdup (restore_token);
+
+  /* 5B: normalize empty source_label to NULL (spec: treat empty as absent). */
+  if (source_label != NULL && *source_label != '\0')
+    {
+      /* 5A: truncate to 256 bytes on a UTF-8 char boundary. */
+      gsize len = strlen (source_label);
+      if (len > 256)
+        {
+          g_warning ("source_label exceeds 256 bytes (%zu), truncating", len);
+          /* g_utf8_find_prev_char walks back to a valid char boundary. */
+          const char *end = source_label + 256;
+          const char *safe = g_utf8_find_prev_char (source_label, end);
+          if (safe != NULL && safe >= source_label)
+            call->source_label = g_strndup (source_label, safe - source_label);
+          else
+            call->source_label = g_strndup (source_label, 256);
+        }
+      else
+        {
+          call->source_label = g_strdup (source_label);
+        }
+    }
+  else
+    {
+      call->source_label = NULL;
+    }
+
+  /* 5A: clamp restore_fail_mode to valid range. */
+  if (restore_fail_mode > XDP_RESTORE_FAIL_MODE_ERROR)
+    {
+      g_warning ("restore_fail_mode %u out of range, clamping to PROMPT (0)",
+                 restore_fail_mode);
+      call->restore_fail_mode = XDP_RESTORE_FAIL_MODE_PROMPT;
+    }
+  else
+    {
+      call->restore_fail_mode = restore_fail_mode;
+    }
   call->multiple = (flags & XDP_SCREENCAST_FLAG_MULTIPLE) != 0;
   call->task = g_task_new (portal, cancellable, callback, data);
 
diff --git a/libportal/remote.h b/libportal/remote.h
index e5e75cb..ff4699d 100644
--- a/libportal/remote.h
+++ b/libportal/remote.h
@@ -110,6 +110,21 @@ typedef enum {
   XDP_PERSIST_MODE_PERSISTENT,
 } XdpPersistMode;
 
+/**
+ * XdpRestoreFailMode:
+ * @XDP_RESTORE_FAIL_MODE_PROMPT: Show the source picker (default).
+ * @XDP_RESTORE_FAIL_MODE_SKIP: Return cancelled without prompting.
+ * @XDP_RESTORE_FAIL_MODE_ERROR: Return error with restore_failed flag.
+ *
+ * Determines what happens when a restore token cannot be honoured.
+ * Requires portal interface version 6 or later.
+ */
+typedef enum {
+  XDP_RESTORE_FAIL_MODE_PROMPT = 0,
+  XDP_RESTORE_FAIL_MODE_SKIP   = 1,
+  XDP_RESTORE_FAIL_MODE_ERROR  = 2,
+} XdpRestoreFailMode;
+
 XDP_PUBLIC
 void        xdp_portal_create_screencast_session            (XdpPortal            *portal,
                                                              XdpOutputType         outputs,
@@ -121,6 +136,19 @@ void        xdp_portal_create_screencast_session            (XdpPortal
                                                              GAsyncReadyCallback   callback,
                                                              gpointer              data);
 
+XDP_PUBLIC
+void        xdp_portal_create_screencast_session_full       (XdpPortal            *portal,
+                                                             XdpOutputType         outputs,
+                                                             XdpScreencastFlags    flags,
+                                                             XdpCursorMode         cursor_mode,
+                                                             XdpPersistMode        persist_mode,
+                                                             const char           *restore_token,
+                                                             const char           *source_label,
+                                                             XdpRestoreFailMode  restore_fail_mode,
+                                                             GCancellable         *cancellable,
+                                                             GAsyncReadyCallback   callback,
+                                                             gpointer              data);
+
 XDP_PUBLIC
 XdpSession *xdp_portal_create_screencast_session_finish     (XdpPortal            *portal,
                                                              GAsyncResult         *result,
-- 
2.53.0

