+fn match_title_regex_rules<'a>(
+    rules: &[RestoreMatchRule],
+    saved_app_id: Option<&str>,
+    toplevel_infos: &'a [ToplevelInfo],
+) -> Option<&'a ToplevelInfo> {
+    for rule in rules {
+        for info in toplevel_infos {
+            if title_regex_rule_auto_matches(rule, saved_app_id, &info.app_id, &info.title) {
+                return Some(info);
+            }
+        }
+    }
+    None
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum MatchKind {
+    Exact,
+    Regex,
+    Title,
+    App,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum MatchDecision {
+    Auto(MatchKind),
+    NeedsConsent,
+}
+
+enum ToplevelMatch<'a> {
+    Auto(&'a ToplevelInfo),
+    NeedsConsent,
+}
+
+fn resolve_toplevel_match<'a>(
+    saved_identifier: &str,
+    mode: u32,
+    saved_app_id: Option<&str>,
+    saved_title: Option<&str>,
+    rules: &[RestoreMatchRule],
+    toplevel_infos: &'a [ToplevelInfo],
+) -> Option<ToplevelMatch<'a>> {
+    if let Some(info) = toplevel_infos
+        .iter()
+        .find(|info| info.identifier == saved_identifier)
+    {
+        return Some(ToplevelMatch::Auto(info));
+    }
+    if mode == RESCUE_MODE_EXACT {
+        return None;
+    }
+
+    if let (Some(app_id), Some(title)) = (saved_app_id, saved_title) {
+        if !app_id.is_empty() {
+            if let Some(info) = toplevel_infos
                 .iter()
-                .find(|t| t.identifier == *identifier)?;
-            toplevels.push(info.foreign_toplevel.clone());
+                .find(|info| info.app_id == app_id && info.title == title)
+            {
+                return Some(ToplevelMatch::Auto(info));
+            }
+        }
+    }
+
+    if mode == RESCUE_MODE_TITLE {
+        if let Some(info) = match_title_regex_rules(rules, saved_app_id, toplevel_infos) {
+            return Some(ToplevelMatch::Auto(info));
+        }
+        if title_regex_rules_need_consent(rules, saved_app_id, toplevel_infos) {
+            return Some(ToplevelMatch::NeedsConsent);
+        }
+        return None;
+    }
+
+    // Mode 1 (App): app_id only, after exact identifier/title specificity.
+    if let Some(app_id) = saved_app_id {
+        if !app_id.is_empty() {
+            if let Some(info) = toplevel_infos.iter().find(|info| info.app_id == app_id) {
+                return Some(ToplevelMatch::Auto(info));
+            }
+        }
+    }
+
+    None
+}
+
+fn match_candidate(
+    candidate_identifier: &str,
+    saved_identifier: &str,
+    mode: u32,
+    saved_app_id: Option<&str>,
+    saved_title: Option<&str>,
+    rules: &[RestoreMatchRule],
+    candidate_app_id: &str,
+    candidate_title: &str,
+) -> Option<MatchDecision> {
+    if candidate_identifier == saved_identifier {
+        return Some(MatchDecision::Auto(MatchKind::Exact));
+    }
+    if mode == RESCUE_MODE_EXACT {
+        return None;
+    }
+    if let (Some(app_id), Some(title)) = (saved_app_id, saved_title) {
+        if !app_id.is_empty() && candidate_app_id == app_id && candidate_title == title {
+            return Some(MatchDecision::Auto(MatchKind::Title));
+        }
+    }
+    if mode == RESCUE_MODE_TITLE {
+        let mut needs_consent = false;
+        for rule in rules {
+            if title_regex_rule_matches(rule, saved_app_id, candidate_app_id, candidate_title) {
+                if title_regex_rule_auto_matches(
+                    rule,
+                    saved_app_id,
+                    candidate_app_id,
+                    candidate_title,
+                ) {
+                    return Some(MatchDecision::Auto(MatchKind::Regex));
+                }
+                needs_consent = true;
+            }
         }
+        if needs_consent {
+            return Some(MatchDecision::NeedsConsent);
+        }
+        return None;
+    }
+    if let Some(app_id) = saved_app_id {
+        if !app_id.is_empty() && candidate_app_id == app_id {
+            return Some(MatchDecision::Auto(MatchKind::App));
+        }
+    }
+    None
+}

-        Some(CaptureSources { outputs, toplevels })
+fn title_regex_rules_need_consent(
+    rules: &[RestoreMatchRule],
+    saved_app_id: Option<&str>,
+    toplevel_infos: &[ToplevelInfo],
+) -> bool {
+    rules.iter().any(|rule| {
+        toplevel_infos.iter().any(|info| {
+            title_regex_rule_matches(rule, saved_app_id, &info.app_id, &info.title)
+                && !title_regex_rule_auto_matches(rule, saved_app_id, &info.app_id, &info.title)
+        })
+    })
+}
+
+fn title_regex_rule_auto_matches(
+    rule: &RestoreMatchRule,
+    saved_app_id: Option<&str>,
+    candidate_app_id: &str,
+    candidate_title: &str,
+) -> bool {
+    matches!(rule.scope, RestoreMatchScope::SameApp)
+        && title_regex_rule_matches(rule, saved_app_id, candidate_app_id, candidate_title)
+}
+
+fn title_regex_rule_matches(
+    rule: &RestoreMatchRule,
+    saved_app_id: Option<&str>,
+    candidate_app_id: &str,
+    candidate_title: &str,
+) -> bool {
+    if matches!(rule.scope, RestoreMatchScope::SameApp) {
+        let Some(app_id) = saved_app_id else {
+            return false;
+        };
+        if app_id.is_empty() || candidate_app_id != app_id {
+            return false;
+        }
     }
+
+    rule.is_match(candidate_title)
 }

