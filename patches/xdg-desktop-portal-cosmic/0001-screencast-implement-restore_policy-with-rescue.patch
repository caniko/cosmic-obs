+fn has_invalid_aliases(args: &Args) -> bool {
+    args.capture_sources.toplevels.iter().any(|toplevel| {
+        args.rescue_alias_rows
+            .get(toplevel)
+            .is_some_and(|rows| alias_rows_to_rules(rows).is_err())
+    })
+}
+
+fn alias_rows_to_rules(rows: &[AliasEditorRow]) -> Result<Vec<RestoreMatchRule>, String> {
+    let mut rules = Vec::new();
+    for (idx, row) in rows.iter().enumerate() {
+        let pattern = row.pattern.trim();
+        if pattern.is_empty() {
+            continue;
+        }
+        RegexBuilder::new(pattern)
+            .case_insensitive(true)
+            .build()
+            .map_err(|err| format!("rule {}: {}", idx + 1, err))?;
+        rules.push(RestoreMatchRule {
+            pattern: pattern.to_string(),
+            scope: row.scope,
+        });
+    }
+    Ok(rules)
+}
+
+pub fn parse_alias_text(text: &str) -> Result<Vec<RestoreMatchRule>, String> {
+    let mut rules = Vec::new();
+    for (line_idx, line) in text.lines().enumerate() {
+        let line = line.trim();
+        if line.is_empty() {
+            continue;
+        }
+
+        let (scope, pattern) = if let Some(pattern) = line.strip_prefix("any_app:") {
+            (RestoreMatchScope::AnyApp, pattern.trim())
+        } else if let Some(pattern) = line.strip_prefix("any:") {
+            (RestoreMatchScope::AnyApp, pattern.trim())
+        } else if let Some(pattern) = line.strip_prefix("same_app:") {
+            (RestoreMatchScope::SameApp, pattern.trim())
+        } else if let Some(pattern) = line.strip_prefix("same:") {
+            (RestoreMatchScope::SameApp, pattern.trim())
+        } else {
+            (RestoreMatchScope::SameApp, line)
+        };
+
+        if pattern.is_empty() {
+            continue;
+        }
+        RegexBuilder::new(pattern)
+            .case_insensitive(true)
+            .build()
+            .map_err(|err| format!("line {}: {}", line_idx + 1, err))?;
+        rules.push(RestoreMatchRule {
+            pattern: pattern.to_string(),
+            scope,
+        });
+    }
+    Ok(rules)
+}
+
+fn initial_alias_rows(info: &ToplevelInfo, seeds: &[RestoreAliasSeed]) -> Vec<AliasEditorRow> {
+    if let Some(seed) = seeds.iter().find(|seed| {
+        !seed.app_id.is_empty() && seed.app_id == info.app_id && !seed.rules.is_empty()
+    }) {
+        return seed.rules.iter().map(AliasEditorRow::from).collect();
+    }
+
+    if let Some(seed) = seeds
+        .iter()
+        .find(|seed| !seed.title.is_empty() && seed.title == info.title && !seed.rules.is_empty())
+    {
+        return seed.rules.iter().map(AliasEditorRow::from).collect();
+    }
+
+    suggest_project_aliases(&info.app_id, &info.title)
+        .into_iter()
+        .map(|pattern| AliasEditorRow {
+            pattern,
+            scope: RestoreMatchScope::SameApp,
+        })
+        .collect()
+}
+
+fn suggest_project_aliases(app_id: &str, title: &str) -> Option<String> {
+    if !is_vscode_like(app_id) {
+        return None;
+    }
+
+    let suffixes = [
+        " - Visual Studio Code",
+        " - Code",
+        " - VSCodium",
+        " - Codium",
+    ];
+    let title = suffixes
+        .iter()
+        .find_map(|suffix| title.strip_suffix(suffix))
+        .unwrap_or(title);
+    let project = title
+        .rsplit(" - ")
+        .find_map(|part| {
+            let part = part.trim();
+            if is_generic_vscode_title_part(part) {
+                None
+            } else {
+                Some(part)
+            }
+        })
+        .map(str::trim)
+        .filter(|s| !s.is_empty())?;
+    Some(regex::escape(project))
+}
+
+fn is_vscode_like(app_id: &str) -> bool {
+    let app_id = app_id.to_ascii_lowercase();
+    app_id.contains("code") || app_id.contains("codium") || app_id.contains("vscode")
+}
+
+fn is_generic_vscode_title_part(part: &str) -> bool {
+    let part = part.trim();
+    if part.is_empty() {
+        return true;
+    }
+    let lower = part.to_ascii_lowercase();
+    matches!(
+        lower.as_str(),
+        "visual studio code"
+            | "code"
+            | "vscodium"
+            | "codium"
+            | "welcome"
+            | "settings"
+            | "extension"
+            | "extensions"
+            | "new window"
+            | "untitled"
+    )
+}
