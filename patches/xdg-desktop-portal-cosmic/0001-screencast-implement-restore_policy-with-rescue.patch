+/// Sanitize a user-provided label per the ScreenCast v6 spec:
+/// strip control characters, truncate to 256 bytes, normalize empty to None.
+fn sanitize_label(input: Option<String>) -> Option<String> {
+    let s = input?;
+    let cleaned: String = s.chars().filter(|c| !is_label_control_char(*c)).collect();
+    if cleaned.is_empty() {
+        return None;
+    }
+    if cleaned.len() <= 256 {
+        return Some(cleaned);
+    }
+    let mut end = 256;
+    while !cleaned.is_char_boundary(end) {
+        end -= 1;
+    }
+    Some(cleaned[..end].to_string())
+}
+
+fn is_label_control_char(c: char) -> bool {
+    matches!(c,
+        '\u{0000}'..='\u{001F}' | '\u{007F}' |
+        '\u{200E}'..='\u{200F}' |
+        '\u{202A}'..='\u{202E}' |
+        '\u{2066}'..='\u{2069}'
+    )
+}
+
+fn restore_policy_action(
+    policy: &Option<HashMap<String, zvariant::OwnedValue>>,
+    reason: &str,
+) -> u32 {
+    let Some(policy) = policy else {
+        return 0;
+    };
+
+    let default_action = policy
+        .get("default_action")
+        .and_then(|v| u32::try_from(v).ok())
+        .filter(|v| *v <= 2)
+        .unwrap_or(0);
+
+    policy
+        .get("actions")
+        .and_then(|v| v.clone().try_into().ok())
+        .and_then(|actions: HashMap<String, u32>| actions.get(reason).copied())
+        .filter(|v| *v <= 2)
+        .unwrap_or(default_action)
+}
+
+fn restore_failure_result(reason: &str, action: u32) -> RestoreFailureResult {
+    RestoreFailureResult {
+        reason: reason.to_string(),
+        action,
+        token_invalid: reason != "source_unavailable",
+    }
+}
