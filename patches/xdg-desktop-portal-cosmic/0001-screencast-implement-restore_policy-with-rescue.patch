+/// Sanitize a user-provided label per the ScreenCast v6 spec:
+/// strip control characters, truncate to 256 bytes, normalize empty to None.
+fn sanitize_label(input: Option<String>) -> Option<String> {
+    let s = input?;
+    let cleaned: String = s.chars().filter(|c| !is_label_control_char(*c)).collect();
+    if cleaned.is_empty() {
+        return None;
+    }
+    if cleaned.len() <= 256 {
+        return Some(cleaned);
+    }
+    let mut end = 256;
+    while !cleaned.is_char_boundary(end) {
+        end -= 1;
+    }
+    Some(cleaned[..end].to_string())
+}
+
+fn is_label_control_char(c: char) -> bool {
+    matches!(c,
+        '\u{0000}'..='\u{001F}' | '\u{007F}' |
+        '\u{200E}'..='\u{200F}' |
+        '\u{202A}'..='\u{202E}' |
+        '\u{2066}'..='\u{2069}'
+    )
+}
+
+fn restore_policy_action(
+    policy: &Option<HashMap<String, zvariant::OwnedValue>>,
+    reason: &str,
+) -> u32 {
+    let Some(policy) = policy else {
+        return 0;
+    };
+
+    let default_action = policy
+        .get("default_action")
+        .and_then(|v| u32::try_from(v).ok())
+        .filter(|v| *v <= 2)
+        .unwrap_or(0);
+
+    policy
+        .get("actions")
+        .and_then(|v| v.clone().try_into().ok())
+        .and_then(|actions: HashMap<String, u32>| actions.get(reason).copied())
+        .filter(|v| *v <= 2)
+        .unwrap_or(default_action)
+}
+
+fn restore_failure_result(reason: &str, action: u32) -> RestoreFailureResult {
+    RestoreFailureResult {
+        reason: reason.to_string(),
+        action,
+        token_invalid: reason != "source_unavailable",
+    }
+}
+
+fn owned_value_string(value: &zvariant::OwnedValue) -> Option<String> {
+    value.clone().try_into().ok()
+}
+
+fn parse_restore_match_rules(
+    rules: Option<Vec<HashMap<String, zvariant::OwnedValue>>>,
+) -> Vec<RestoreMatchRule> {
+    let mut parsed = Vec::new();
+    for rule in rules.unwrap_or_default() {
+        let kind = rule.get("kind").and_then(owned_value_string);
+        if kind.as_deref() != Some("title_regex") {
+            continue;
+        }
+
+        let Some(pattern) = rule.get("pattern").and_then(owned_value_string) else {
+            continue;
+        };
+        if pattern.trim().is_empty() {
+            continue;
+        }
+
+        let scope = rule.get("scope").and_then(owned_value_string);
+        if let Some(rule) = parse_external_restore_match_rule(pattern, scope) {
+            parsed.push(rule);
+        }
+    }
+    parsed
+}
+
+fn parse_external_restore_match_rule(
+    pattern: String,
+    scope: Option<String>,
+) -> Option<RestoreMatchRule> {
+    let scope = match scope.as_deref() {
+        Some(scope) => match RestoreMatchScope::from_str(scope) {
+            Some(scope) => scope,
+            None => {
+                log::warn!(
+                    "restore: ignoring title_regex rule with invalid scope {:?}",
+                    scope
+                );
+                return None;
+            }
+        },
+        None => RestoreMatchScope::SameApp,
+    };
+
+    if let Err(err) = RegexBuilder::new(&pattern).case_insensitive(true).build() {
+        log::warn!(
+            "restore: ignoring invalid external title_regex rule {:?}: {}",
+            pattern,
+            err
+        );
+        return None;
+    }
+
+    Some(RestoreMatchRule { pattern, scope })
+}
