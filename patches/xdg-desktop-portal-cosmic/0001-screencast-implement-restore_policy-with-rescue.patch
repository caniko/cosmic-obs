+                            "restore: app_id={} matched but title={:?} did not",
+                            aid,
+                            title,
+                        );
+                    }
+                }
+                log::debug!(
+                    "restore: title match failed for app_id={:?} title={:?}",
+                    app_id,
+                    title,
+                );
+                return None;
+            }
+
+            // Mode 1 (App): app_id only — grab any window from this app
+            if let Some(aid) = app_id {
+                if !aid.is_empty() {
+                    if let Some(info) = toplevel_infos.iter().find(|ti| ti.app_id == *aid) {
+                        toplevels.push(info.foreign_toplevel.clone());
+                        continue;
+                    }
+                }
+            }
+
+            log::debug!("restore: app match failed for app_id={:?}", app_id);
+            return None;
         }
 
-        Some(CaptureSources { outputs, toplevels })
