+
+fn match_title_regex_rules<'a>(
+    rules: &[RestoreMatchRule],
+    saved_app_id: Option<&String>,
+    toplevel_infos: &'a [ToplevelInfo],
+) -> Option<&'a ToplevelInfo> {
+    for rule in rules {
+        let re = match RegexBuilder::new(&rule.pattern)
+            .case_insensitive(true)
+            .build()
+        {
+            Ok(re) => re,
+            Err(err) => {
+                log::warn!(
+                    "restore: ignoring invalid title_regex rescue rule {:?}: {}",
+                    rule.pattern,
+                    err
+                );
+                continue;
+            }
+        };
+
+        for info in toplevel_infos {
+            if matches!(rule.scope, RestoreMatchScope::SameApp) {
+                let Some(app_id) = saved_app_id else {
+                    continue;
+                };
+                if app_id.is_empty() || info.app_id != *app_id {
+                    continue;
+                }
+            }
+
+            if re.is_match(&info.title) {
+                return Some(info);
+            }
+        }
     }
+    None
 }
