+fn sync_capture_aliases(args: &mut Args) {
+    args.capture_sources.rescue_match_rules.clear();
+    for toplevel in &args.capture_sources.toplevels {
+        let rules = args
+            .rescue_alias_editors
+            .get(toplevel)
+            .map(|content| parse_alias_text(&content.text()).unwrap_or_default())
+            .unwrap_or_default();
+        args.capture_sources.rescue_match_rules.push(rules);
+    }
+}
+
+fn has_invalid_aliases(args: &Args) -> bool {
+    args.capture_sources.toplevels.iter().any(|toplevel| {
+        args.rescue_alias_editors
+            .get(toplevel)
+            .is_some_and(|content| parse_alias_text(&content.text()).is_err())
+    })
+}
+
+pub fn parse_alias_text(text: &str) -> Result<Vec<RestoreMatchRule>, String> {
+    let mut rules = Vec::new();
+    for (line_idx, line) in text.lines().enumerate() {
+        let line = line.trim();
+        if line.is_empty() {
+            continue;
+        }
+
+        let (scope, pattern) = if let Some(pattern) = line.strip_prefix("any_app:") {
+            (RestoreMatchScope::AnyApp, pattern.trim())
+        } else if let Some(pattern) = line.strip_prefix("any:") {
+            (RestoreMatchScope::AnyApp, pattern.trim())
+        } else if let Some(pattern) = line.strip_prefix("same_app:") {
+            (RestoreMatchScope::SameApp, pattern.trim())
+        } else if let Some(pattern) = line.strip_prefix("same:") {
+            (RestoreMatchScope::SameApp, pattern.trim())
+        } else {
+            (RestoreMatchScope::SameApp, line)
+        };
+
+        if pattern.is_empty() {
+            continue;
+        }
+        RegexBuilder::new(pattern)
+            .case_insensitive(true)
+            .build()
+            .map_err(|err| format!("line {}: {}", line_idx + 1, err))?;
+        rules.push(RestoreMatchRule {
+            pattern: pattern.to_string(),
+            scope,
+        });
+    }
+    Ok(rules)
+}
+
+fn suggest_project_aliases(info: &ToplevelInfo) -> Option<String> {
+    if !is_vscode_like(&info.app_id) {
+        return None;
+    }
+
+    let suffixes = [
+        " - Visual Studio Code",
+        " - Code",
+        " - VSCodium",
+        " - Codium",
+    ];
+    let title = suffixes
+        .iter()
+        .find_map(|suffix| info.title.strip_suffix(suffix))
+        .unwrap_or(&info.title);
+    let project = title
+        .rsplit(" - ")
+        .next()
+        .map(str::trim)
+        .filter(|s| !s.is_empty())?;
+    Some(regex::escape(project))
+}
+
+fn is_vscode_like(app_id: &str) -> bool {
+    let app_id = app_id.to_ascii_lowercase();
+    app_id.contains("code")
+        || app_id.contains("codium")
+        || app_id.contains("vscode")
+}
