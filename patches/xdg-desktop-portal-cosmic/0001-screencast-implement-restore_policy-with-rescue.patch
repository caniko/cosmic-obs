+
+fn match_title_regex_rules<'a>(
+    rules: &[RestoreMatchRule],
+    saved_app_id: Option<&str>,
+    toplevel_infos: &'a [ToplevelInfo],
+) -> Option<&'a ToplevelInfo> {
+    for rule in rules {
+        for info in toplevel_infos {
+            if title_regex_rule_matches(rule, saved_app_id, &info.app_id, &info.title) {
+                return Some(info);
+            }
+        }
+    }
+    None
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum MatchKind {
+    Exact,
+    Regex,
+    Title,
+    App,
+}
+
+fn match_candidate(
+    candidate_identifier: &str,
+    saved_identifier: &str,
+    mode: u32,
+    saved_app_id: Option<&str>,
+    saved_title: Option<&str>,
+    rules: &[RestoreMatchRule],
+    candidate_app_id: &str,
+    candidate_title: &str,
+) -> Option<MatchKind> {
+    if candidate_identifier == saved_identifier {
+        return Some(MatchKind::Exact);
+    }
+    if mode == RESCUE_MODE_EXACT {
+        return None;
+    }
+    if mode == RESCUE_MODE_TITLE {
+        if rules.iter().any(|rule| {
+            title_regex_rule_matches(rule, saved_app_id, candidate_app_id, candidate_title)
+        }) {
+            return Some(MatchKind::Regex);
+        }
+        if let (Some(app_id), Some(title)) = (saved_app_id, saved_title) {
+            if !app_id.is_empty() && candidate_app_id == app_id && candidate_title == title {
+                return Some(MatchKind::Title);
+            }
+        }
+        return None;
+    }
+    if let Some(app_id) = saved_app_id {
+        if !app_id.is_empty() && candidate_app_id == app_id {
+            return Some(MatchKind::App);
+        }
+    }
+    None
+}
+
+fn title_regex_rule_matches(
+    rule: &RestoreMatchRule,
+    saved_app_id: Option<&str>,
+    candidate_app_id: &str,
+    candidate_title: &str,
+) -> bool {
+    if matches!(rule.scope, RestoreMatchScope::SameApp) {
+        let Some(app_id) = saved_app_id else {
+            return false;
+        };
+        if app_id.is_empty() || candidate_app_id != app_id {
+            return false;
+        }
+    }
+
+    match RegexBuilder::new(&rule.pattern)
+        .case_insensitive(true)
+        .build()
+    {
+        Ok(re) => re.is_match(candidate_title),
+        Err(err) => {
+            log::warn!(
+                "restore: ignoring invalid title_regex rescue rule {:?}: {}",
+                rule.pattern,
+                err
+            );
+            false
+        }
     }
