+    fn parses_alias_text_prefixes_and_blank_lines() {
+        let rules = parse_alias_text(
+            "\n\
+             project-a\n\
+             same: project-b\n\
+             same_app: project-c\n\
+             any: project-d\n\
+             any_app: project-e\n",
+        )
+        .unwrap();
+
+        assert_eq!(rules.len(), 5);
+        assert_eq!(rules[0].pattern, "project-a");
+        assert_eq!(rules[0].scope, RestoreMatchScope::SameApp);
+        assert_eq!(rules[1].scope, RestoreMatchScope::SameApp);
+        assert_eq!(rules[2].scope, RestoreMatchScope::SameApp);
+        assert_eq!(rules[3].scope, RestoreMatchScope::AnyApp);
+        assert_eq!(rules[4].scope, RestoreMatchScope::AnyApp);
+    }
