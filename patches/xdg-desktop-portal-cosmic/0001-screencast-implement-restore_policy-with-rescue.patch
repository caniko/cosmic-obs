+        for (i, identifier) in self.toplevels.iter().enumerate() {
+            let app_id = self.toplevel_app_ids.get(i);
+            let title = self.toplevel_titles.get(i);
+            let mode = self.rescue_modes.get(i).copied().unwrap_or(RESCUE_MODE_APP);
+
+            // Tier 1 (all modes): exact identifier match
+            if let Some(info) = toplevel_infos.iter().find(|t| t.identifier == *identifier) {
+                toplevels.push(info.foreign_toplevel.clone());
+                continue;
+            }
+
+            // Mode 0 (Exact): no fallback
+            if mode == RESCUE_MODE_EXACT {
+                log::debug!("restore: exact match failed for identifier={}", identifier);
+                return None;
