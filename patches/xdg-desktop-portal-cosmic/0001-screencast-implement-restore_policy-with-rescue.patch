+    pub fn new(app_id: String, title: String, rules: Vec<RestoreMatchRule>) -> Self {
+        Self {
+            app_id,
+            title,
+            rules,
+        }
+    }
+}
+
+impl RestoreMatchRule {
+    pub fn new(pattern: String, scope: RestoreMatchScope) -> Result<Self, String> {
+        if pattern.len() > MAX_RESTORE_MATCH_PATTERN_BYTES {
+            return Err(format!(
+                "pattern exceeds {} bytes",
+                MAX_RESTORE_MATCH_PATTERN_BYTES
+            ));
+        }
+
+        let regex = RegexBuilder::new(&pattern)
+            .case_insensitive(true)
+            .size_limit(RESTORE_MATCH_REGEX_SIZE_LIMIT)
+            .dfa_size_limit(RESTORE_MATCH_REGEX_DFA_SIZE_LIMIT)
+            .build()
+            .map_err(|err| err.to_string())?;
+
+        Ok(Self {
+            pattern,
+            scope,
+            regex,
+        })
+    }
+
+    pub fn is_match(&self, title: &str) -> bool {
+        self.regex.is_match(title)
+    }
+}
+
+#[derive(Clone, Debug)]
+struct AliasEditorRow {
+    pattern: String,
+    scope: RestoreMatchScope,
+}
+
+impl From<&RestoreMatchRule> for AliasEditorRow {
+    fn from(rule: &RestoreMatchRule) -> Self {
+        Self {
+            pattern: rule.pattern.clone(),
+            scope: rule.scope,
+        }
+    }
+}
+
+impl RestoreMatchScope {
+    pub fn as_str(self) -> &'static str {
+        match self {
+            RestoreMatchScope::SameApp => "same_app",
+            RestoreMatchScope::AnyApp => "any_app",
+        }
+    }
+
+    pub fn from_str(scope: &str) -> Option<Self> {
+        match scope {
+            "same_app" | "same" => Some(Self::SameApp),
+            "any_app" | "any" => Some(Self::AnyApp),
+            _ => None,
+        }
+    }
+}
